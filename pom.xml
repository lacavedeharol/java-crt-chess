<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lacavedeharol</groupId>
    <artifactId>java-crt-chess</artifactId>
    <version>1.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>java-crt-chess</name>
    <description>Java chess engine built in the spirit of early computer chess.</description>
    <url>https://github.com/lacavedeharol/java-crt-chess</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <java.version>25</java.version>
        <exec.mainClass>com.lacavedeharol.chess.Main</exec.mainClass>

        <stockfish.baseUrl>https://github.com/official-stockfish/Stockfish/releases/download/sf_18</stockfish.baseUrl>
    </properties>

    <profiles>
        <profile>
            <id>stockfish-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <stockfish.archive>stockfish-windows-x86-64-avx2.zip</stockfish.archive>
                <!-- <stockfish.sha256></stockfish.sha256> -->
            </properties>
        </profile>
        <profile>
            <id>stockfish-linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                </os>
            </activation>
            <properties>
                <stockfish.archive>stockfish-ubuntu-x86-64-avx2.tar</stockfish.archive>
                <!-- <stockfish.sha256></stockfish.sha256> -->
            </properties>
        </profile>
    </profiles>

    <developers>
        <developer>
            <id>lacavedeharol</id>
            <email>lacavedeharol@gmail.com</email>
            <url>https://github.com/lacavedeharol</url>
        </developer>
    </developers>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Stockfish binary downloaded at build time (see download plugin
                 below). Unpacked under target/ and swept into the jar at
                 /stockfish/, where StockfishEngine reads it via the classpath. -->
            <resource>
                <directory>${project.build.directory}/generated-resources/sf-extracted/stockfish</directory>
                <targetPath>stockfish</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <!-- Download + unpack the Stockfish engine binary for this
                     platform during generate-resources. The archive name is set
                     by the OS-activated profile (stockfish.archive). -->
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>1.13.0</version>
                <executions>
                    <execution>
                        <id>fetch-stockfish</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>${stockfish.baseUrl}/${stockfish.archive}</url>
                            <unpack>true</unpack>
                            <outputDirectory>
                                ${project.build.directory}/generated-resources/sf-extracted</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- exec -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <!-- javadoc -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- jar -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${exec.mainClass}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <!-- fat jar -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${exec.mainClass}</mainClass>
                                </transformer>
                            </transformers>
                            <finalName>${project.artifactId}-${project.version}-fat</finalName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>